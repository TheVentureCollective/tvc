---
import "../styles/global.css";
import site from "../data/site.js";

const { title, description, page, cta = true } = Astro.props;
const nav = [
  { href: "/", label: "Home", id: "home" },
  { href: "/approach", label: "Approach", id: "approach" },
  { href: "/portfolio", label: "Portfolio", id: "portfolio" },
  { href: "/icymi", label: "ICYMI", id: "icymi" }
];
const current = (id) => (id === page ? "page" : undefined);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,400;0,500;0,600;1,400;1,500&family=IBM+Plex+Mono:wght@400;500&display=swap">
</head>
<body>
  <header class="site-header">
    <nav class="wrap" aria-label="Main">
      <a href="/" class="wordmark">The Venture Collective<span class="dot">.</span></a>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="nav-links">
        <span class="sr-only">Menu</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 7h18M3 17h18"/></svg>
      </button>
      <div class="nav-links" id="nav-links">
        {nav.map((n) => <a href={n.href} aria-current={current(n.id)}>{n.label}</a>)}
        <a href="/contact" class="nav-cta" aria-current={current("contact")}>Get in touch</a>
      </div>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      {cta && (
        <div class="split end footer-cta">
          <h2 class="h2 flush">Building in a legacy industry<span class="dot">?</span></h2>
          <div class="btns"><a href="/contact" class="btn btn-fill">Get in touch</a></div>
        </div>
      )}
      <div class="footer-bar">
        <span>© 2026 The Venture Collective</span>
        <nav aria-label="Footer">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          <a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href={site.links.medium} target="_blank" rel="noopener">Medium ↗</a>
        </nav>
      </div>
    </div>
  </footer>

  <script>
    import "../scripts/motion.js";

    const header = document.querySelector(".site-header");
    const menu = header.querySelector(".menu-btn");
    menu.addEventListener("click", () => {
      const open = header.classList.toggle("open");
      menu.setAttribute("aria-expanded", String(open));
    });

    window.TVC_MOTION.reveal();
  </script>
</body>
</html>
